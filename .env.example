# Copy this file to .env and fill in your own values. Never commit the real .env.

# Get a free RPC URL from Alchemy (https://alchemy.com) or Infura (https://infura.io)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY

# Private key of the deployer wallet (use a throwaway testnet-only wallet, never your main wallet)
PRIVATE_KEY=your_testnet_private_key_here

# Optional, for contract verification on Etherscan
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Backend server config
PORT=4000
# Pinata (free tier): https://app.pinata.cloud -> API Keys
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret

# Must match the addresses printed by `npx hardhat run scripts/deploy.js --network sepolia`
REGISTRY_ADDRESS=
STAKE_MANAGER_ADDRESS=
ESCROW_ADDRESS=
DISCLOSURE_TIMER_ADDRESS=
